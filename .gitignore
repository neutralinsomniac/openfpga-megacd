# direnv cache (generated from .envrc / the flake)
/.direnv/

# Quartus artifacts if a flow is ever run from the repo root
# (the normal build runs in src/fpga, which has its own .gitignore)
#
# The project files matter as much as the artifacts: a stray ap_core.qpf /
# megacd.qsf here makes `quartus_* ap_core -c megacd` from the repo root open
# a second, fit-less copy of the project and report "Fitter failed or was not
# run" against a build that actually succeeded in src/fpga. Easy to misread as
# a corrupt database.
/*.qpf
/*.qsf
/db/
/incremental_db/
/greybox_tmp/
/hps_isw_handoff/
/output_files/
/*.rpt
/*.summary
/*.qmsg
/*.smsg
/*.qws
/*.pin
/*.sof
/*.pof
/PLLJ_PLLSPE_INFO.txt
/c5_pin_model_dump.txt

# OS / editor cruft
.DS_Store
*~
*.sw?
# Verilator build output (any sim subdir)
sim/*/obj_dir/
sim/full/*.hex
sim/full/bios_*.hex

# Claude Code per-user local settings
.claude/settings.local.json
